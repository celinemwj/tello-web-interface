# Copier ce fichier en ".env" à la racine du projet et renseigner les valeurs.
# Le fichier .env ne doit jamais être commité (voir .gitignore).

# Clé API Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modèle utilisé par le traducteur (facultatif).
# Valeur par défaut si vide : gemini-2.5-flash-lite
GEMINI_MODEL=
